<ci:SettingsPageBase x:Class="SuperAutoBackup.SuperAutoBackupSettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      mc:Ignorable="d" 
      d:DesignHeight="450" 
      d:DesignWidth="800">

    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">
            
            <Label FontSize="20"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                SuperAutoBackup
            </Label>
            
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <ci:FluentIcon FontSize="56"
                    Glyph="&#xE5B7;"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />
                <Label VerticalAlignment="Center" FontSize="28">超级自动备份 · 设置</Label>
            </StackPanel>

            <!-- 警告信息 -->
            <controls:InfoBar IsOpen="True" 
                  IsClosable="False"
                  Severity="Warning"
                  Margin="0,0,0,12">
               <controls:InfoBar.Message>
                     备份过程大约需要20~40秒，这取决于您的电脑配置。在这期间，请不要对ClassIsland各页面进行任何操作，否则可能导致您的应用未响应。备份结束后将恢复正常。
               </controls:InfoBar.Message>
            </controls:InfoBar>

            <!-- 自动备份开关 -->
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE342;}"
                                       Header="自动备份"
                                       Description="启用后在 ClassIsland 启动时自动备份">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ViewModel.Config.IsAutoBackupEnabled, Mode=TwoWay}" />
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <!-- 备份数量上限 -->
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE07F;}"
                                       Header="备份数量上限"
                                       Description="设置最大备份文件数量，超过将删除最早备份（不建议大于5个）">
                <controls:SettingsExpander.Footer>
                    <NumericUpDown Value="{Binding ViewModel.Config.BackupCountLimit, Mode=TwoWay}"
                                   Minimum="1" 
                                   Maximum="100"
                                   Increment="1"
                                   FormatString="N0"
                                   Width="100"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <!-- 生成日志开关 -->
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE69F;}"
                                       Header="生成日志"
                                       Description="启用后将在备份时在备份文件夹生成日志文件">
                <controls:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ViewModel.Config.IsLogGenerationEnabled, Mode=TwoWay}"/>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>

            <!-- 备份文件夹路径 -->
            <controls:SettingsExpander IconSource="{ci:FluentIconSource &#xE87B;}"
                                       Header="备份文件夹路径"
                                       Description="选择备份文件的保存位置">
                <controls:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox Text="{Binding ViewModel.Config.BackupFolderPath}"
                                 Width="250" 
                                 IsReadOnly="True"/>
                        <Button Content="选择" 
                                Click="SelectBackupFolder_Click"/>
                    </StackPanel>
                </controls:SettingsExpander.Footer>
            </controls:SettingsExpander>
            
            <!-- 操作按钮 -->
            <StackPanel Orientation="Horizontal" 
                        Margin="0,20,0,0" 
                        Spacing="10">
                <Button Name="ManualBackupButton" 
                        Content="手动备份" 
                        Click="ManualBackup_Click"
                        IsEnabled="{Binding !ViewModel.Config.IsBackupInProgress}"/>
                <Button Name="OpenBackupFolderButton" 
                        Content="查看备份文件夹" 
                        Click="OpenBackupFolder_Click"/>
            </StackPanel>
            
            <!-- 版权信息 -->
            <TextBlock Text="Programmer_Wang © 2025 - 2026" 
                      HorizontalAlignment="Center" 
                      Margin="0,40,0,0"
                      Foreground="Gray"
                      FontSize="12"
                      Opacity="0.7"/>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>